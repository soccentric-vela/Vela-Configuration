{
  "platform": "vela",
  "model": "qualcomm-qcs6490",
  "board_name": "Qualcomm RB3 Gen 2 (Vela)",
  "has_rtc": true,
  "has_tpm": true,
  "secure_boot": true,
  "service_allowlist": [
    "sshd.service",
    "systemd-networkd.service",
    "systemd-resolved.service",
    "wpa_supplicant.service",
    "webconfigd.service"
  ],
  "peripherals": [
    {
      "id": "ttyS0",
      "device": "/dev/ttyS0",
      "human_name": "UART 0 (console)",
      "kind": "serial",
      "caps": { "modes": ["rs232"] }
    },
    {
      "id": "ttyS1",
      "device": "/dev/ttyS1",
      "human_name": "UART 1 (QUP)",
      "kind": "serial",
      "caps": { "modes": ["rs232"] }
    },
    {
      "id": "ttyS2",
      "device": "/dev/ttyS2",
      "human_name": "UART 2 (QUP)",
      "kind": "serial",
      "caps": { "modes": ["rs232"] }
    },
    {
      "id": "can0",
      "device": "can0",
      "human_name": "CAN channel 0",
      "kind": "can",
      "caps": { "fd": true, "termination_gpio": "gpio-can0-term" }
    },
    {
      "id": "i2c-0",
      "device": "/dev/i2c-0",
      "human_name": "I2C bus 0 (QUP)",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "i2c-2",
      "device": "/dev/i2c-2",
      "human_name": "I2C bus 2 (QUP)",
      "kind": "i2c",
      "caps": {}
    },
    {
      "id": "spi0",
      "device": "/dev/spidev0.0",
      "human_name": "SPI bus 0 (QUP)",
      "kind": "spi",
      "caps": {}
    },
    {
      "id": "gpio-led-system",
      "device": "gpiochip0 line 15",
      "human_name": "System status LED",
      "kind": "gpio",
      "caps": { "direction": "out", "active_low": false, "function": "led", "role": "system" }
    },
    {
      "id": "gpio-btn-recovery",
      "device": "gpiochip0 line 17",
      "human_name": "Recovery button",
      "kind": "gpio",
      "caps": { "direction": "in", "active_low": true }
    },
    {
      "id": "gpio-can0-term",
      "device": "gpiochip0 line 19",
      "human_name": "CAN0 termination",
      "kind": "gpio",
      "caps": { "direction": "out" }
    },
    {
      "id": "mcu-q6",
      "device": "rproc0",
      "human_name": "Hexagon DSP real-time core",
      "kind": "mcu",
      "caps": {
        "protocol": "rpmsg",
        "signed_fw": true,
        "settings_schema": "app:mcu-stm32",
        "firmware_pubkey_ed25519": "PLACEHOLDER",
        "_firmware_pubkey_note": "PLACEHOLDER — replace with the real Hexagon firmware-signing public key at BSP provisioning time"
      }
    },
    {
      "id": "cam0",
      "device": "/dev/video0",
      "human_name": "CSI camera 0 (vision)",
      "kind": "camera",
      "caps": {}
    },
    {
      "id": "thermal-zone-0",
      "device": "/sys/class/thermal/thermal_zone0",
      "human_name": "SoC thermal zone",
      "kind": "thermal",
      "caps": { "throttle": true }
    },
    {
      "id": "eth0",
      "device": "eth0",
      "human_name": "Ethernet 0",
      "kind": "net",
      "caps": {}
    },
    {
      "id": "wlan0",
      "device": "wlan0",
      "human_name": "Wi-Fi 6",
      "kind": "net",
      "caps": { "ap": true }
    }
  ],
  "wifi_radio": {
    "interface": "wlan0",
    "hw_mode": "a",
    "channel": 149
  },
  "dashboard_tiles": [
    { "id": "cpu", "title": "CPU utilization", "metrics": ["cpu.util"], "render": "sparkline" },
    { "id": "thermal", "title": "Thermal / throttle", "metrics": ["thermal.temp", "temp.throttled"], "render": "state" },
    { "id": "q6", "title": "Hexagon heartbeat", "metrics": ["mcu.heartbeat", "mcu.fw_version"], "render": "state" },
    { "id": "gpu", "title": "GPU utilization", "metrics": ["gpu.util"], "render": "sparkline" }
  ],
  "default_alert_rules": [
    { "id": "disk-full", "enabled": true, "metric": "disk.pct", "comparison": ">", "threshold": 90, "duration_secs": 60, "actions": ["ui"] },
    { "id": "watchdog-reset", "enabled": true, "metric": "boot.watchdog", "comparison": ">", "threshold": 0, "duration_secs": 0, "actions": ["ui"] },
    { "id": "throttling", "enabled": true, "metric": "temp.throttled", "comparison": ">", "threshold": 0, "duration_secs": 30, "actions": ["ui"] },
    { "id": "cert-expiry", "enabled": true, "metric": "cert.*", "comparison": "<", "threshold": 30, "duration_secs": 0, "actions": ["ui"] }
  ]
}
